// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  // Cây nhiều cấp; null = gốc. Chặn vòng lặp ở service (ADR 0001).
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(150)
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String        @map("category_id") @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?
  // Bắt buộc, > 0 (CHECK trong migration) — tính phí ship (BR-CAT-06).
  weightGrams Int           @map("weight_grams")
  gender      Gender        @default(UNISEX)
  status      ProductStatus @default(DRAFT)
  // Lần đầu chuyển sang ACTIVE; không đổi khi archive/unarchive.
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category         @relation(fields: [categoryId], references: [id])
  images   ProductImage[]
  variants ProductVariant[]

  @@index([categoryId, status, createdAt(sort: Desc)])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  // Ảnh theo màu: mọi size cùng màu dùng chung bộ ảnh (BR-CAT-05).
  colorId    String   @map("color_id") @db.Uuid
  // Key object storage, không lưu URL tuyệt đối.
  storageKey String   @map("storage_key")
  altText    String?  @map("alt_text") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  // Tối đa một ảnh primary mỗi (product, color): partial unique index trong migration.
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color   @relation(fields: [colorId], references: [id], onDelete: Restrict)

  @@index([productId, colorId, sortOrder])
  @@index([colorId])
  @@map("product_images")
}

model ProductVariant {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  sizeId    String        @map("size_id") @db.Uuid
  colorId   String        @map("color_id") @db.Uuid
  // CHECK ^[A-Z0-9-]+$ trong migration (BR-CAT-03); không đổi được qua API.
  sku       String        @unique @db.VarChar(100)
  // VND số nguyên, CHECK > 0 trong migration (BR-CAT-04).
  price     BigInt
  status    VariantStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  size       Size        @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  color      Color       @relation(fields: [colorId], references: [id], onDelete: Restrict)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, sizeId, colorId])
  @@index([productId, createdAt(sort: Desc)])
  @@index([sizeId])
  @@index([colorId])
  @@map("product_variants")
}

// Danh sách size dùng chung do Admin quản lý (BR-CAT-11). Không xoá, chỉ ẩn.
model Size {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(50)
  sortOrder Int      @default(0) @map("sort_order")
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants ProductVariant[]

  @@map("sizes")
}

// Bảng màu dùng chung do Admin quản lý (BR-CAT-11). Không xoá, chỉ ẩn.
model Color {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(50)
  // #RRGGBB, CHECK trong migration.
  hex       String   @db.Char(7)
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variants ProductVariant[]
  images   ProductImage[]

  @@map("colors")
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  variantId        String   @unique @map("variant_id") @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique @map("order_number") @db.VarChar(30)
  userId      String      @map("user_id") @db.Uuid
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @map("total_amount") @db.Decimal(12, 2)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(255)
  sku         String   @db.VarChar(100)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

// Back-office write log (11-database §4.1). Append-only; entity_id is a soft
// reference (no FK) so the log survives whatever happens to the entity.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  reason      String?
  requestId   String?  @map("request_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
