{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/protect-files.sh",
        "cwd": ".",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/enforce-git-workflow.sh",
        "cwd": ".",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/enforce-pr-template.sh",
        "cwd": ".",
        "timeoutSec": 60
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/check-swagger-completeness.sh",
        "cwd": ".",
        "timeoutSec": 15
      },
      {
        "type": "command",
        "bash": "./.github/hooks/scripts/after-pr-create.sh",
        "cwd": ".",
        "timeoutSec": 15
      }
    ]
  }
}
