DATABASE_URL=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Port app lắng nghe — bỏ trống thì mặc định 3000.
PORT=

# Access token (JWT, stateless, short TTL) + refresh token (opaque, DB-backed
# via TokenService, set as an HttpOnly cookie). JWT_ACCESS_SECRET must be a
# long random string, never committed — generate your own for local dev.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# SMTP for transactional email (verify-email code, forgot-password links).
# Leave all 4 unset to keep emails logged only (no real send) — that's the
# default, safe for local dev/CI without real credentials.
# For local testing with a real inbox-like view (nothing gets delivered to
# a real recipient), https://mailtrap.io gives free sandbox SMTP creds.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# Base URL of the frontend app — used to build links inside transactional
# emails (verify-email, forgot-password). Defaults to http://localhost:3000
# if unset.
FRONTEND_URL=

# Object storage (S3-compatible) for the upload-image module — presigned upload flow.
# Local dev: point at a MinIO instance (see docker-compose.yml; service `minio-init`
# creates the bucket and the required `tmp/` 1-day expiry rule, docs/adr/0010).
# All 5 below S3_PUBLIC_ENDPOINT are required at boot (UploadImageModule constructs
# its S3 client eagerly). Local MinIO values: S3_ENDPOINT=http://localhost:9000,
# S3_BUCKET=media, S3_REGION=us-east-1, S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY=minioadmin.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: endpoint the client (browser) can reach, used for presigned upload URLs
# and the public image URLs stored in the DB. Set it when the backend reaches storage
# through an internal hostname (e.g. http://minio:9000 inside docker-compose) —
# leave empty to reuse S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=

# Postman sync (npm run postman:sync) — pushes the app's live OpenAPI spec
# (Swagger, /api-json) into an existing Postman collection, so new/changed
# API endpoints show up in Postman without manually re-creating requests.
# POSTMAN_API_KEY: personal API key from https://web.postman.co/settings/me/api-keys
# POSTMAN_COLLECTION_ID: the target collection's ID (from its Postman URL).
POSTMAN_API_KEY=
POSTMAN_COLLECTION_ID=
