# =============================================================================
# Environment variables. Copy to .env and fill in. Never commit .env.
# Validated at startup in src/config/env.validation.ts (fail-fast).
# Sections marked [PLANNED] are from docs/architecture (06, 09) and are not
# read by the code yet. Add them to env.validation.ts when the module lands.
# =============================================================================

# --- App ---------------------------------------------------------------------
# Port the app listens on. Defaults to 3000 when empty.
PORT=
# Base URL of the frontend, used for links in emails and payment return URLs.
# Defaults to http://localhost:3000 when empty.
FRONTEND_URL=
# Serve Swagger UI (/docs) and spec (/docs-json): 'true' | 'false'.
# Defaults to on when empty, off when NODE_ENV=production.
SWAGGER_ENABLED=

# --- Database (required) -----------------------------------------------------
# Local compose maps 5432; override the host port in docker-compose.override.yml
# if 5432 is taken, and change the port here to match.
DATABASE_URL=postgresql://nestjs_demo:nestjs_demo@localhost:5432/nestjs_demo

# --- Admin bootstrap (required) ----------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=
# Must pass the strong-password rule.
ADMIN_BOOTSTRAP_PASSWORD=

# --- Auth (JWT_ACCESS_SECRET required) ---------------------------------------
# Access token: stateless JWT, short TTL. Refresh token: opaque, stored in DB,
# sent as an HttpOnly cookie. Secret: random, at least 32 chars
# (e.g. `openssl rand -hex 32`).
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# --- Email / SMTP ------------------------------------------------------------
# Leave HOST/PORT/USER/PASS empty to only log emails (safe for local dev & CI).
# For a sandbox inbox use https://mailtrap.io.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- Redis [PLANNED]: queue (BullMQ), rate limit, cache ----------------------
REDIS_URL=redis://localhost:6379

# --- Object storage, S3-compatible [PLANNED]: product images -----------------
# Local: MinIO. Production: any S3-compatible provider.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Payment: VNPay [PLANNED] (sandbox outside production) -------------------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# --- Payment: MoMo [PLANNED] (sandbox outside production) --------------------
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn

# Public base URL of this API, used to build IPN / webhook callback URLs
# that VNPay, MoMo and GHN call. Must be reachable from the internet
# (use a tunnel such as ngrok for local testing).
PUBLIC_API_URL=

# --- Shipping: GHN [PLANNED] -------------------------------------------------
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_TOKEN=
GHN_SHOP_ID=

# --- Dev tooling: Postman sync (npm run postman:sync) ------------------------
# Pushes the live OpenAPI spec into an existing Postman collection.
# POSTMAN_API_KEY: https://web.postman.co/settings/me/api-keys
# POSTMAN_COLLECTION_ID: taken from the collection's Postman URL.
# POSTMAN_WORKSPACE_ID: optional, workspace for the temporary import collection;
#   defaults to the key owner's oldest personal workspace when empty.
# OPENAPI_URL: defaults to http://localhost:3000/docs-json when empty.
POSTMAN_API_KEY=
POSTMAN_COLLECTION_ID=
POSTMAN_WORKSPACE_ID=
OPENAPI_URL=
