# Copy this file to docker-compose.override.yml (gitignored, personal — docker
# compose loads it automatically alongside docker-compose.yml) if host port
# 5432 is already taken by another local Postgres (a native install, another
# project's container, etc). Symptom: `prisma migrate`/`db:seed`/`test:e2e`
# fail with P1000 "Authentication failed" even though the credentials in
# .env are correct — this is TCP requests landing on the WRONG Postgres
# instance sharing the port, not a real credential mismatch. Verify with
# `netstat -ano | grep :5432` (Windows) / `lsof -i :5432` (macOS/Linux): if
# more than one process is listed, you have this conflict.
#
# After copying, also update DATABASE_URL in your .env to use port 5433.
services:
  postgres:
    ports: !override # replace, not append, the base file's '5432:5432' mapping
      - '5433:5432'
